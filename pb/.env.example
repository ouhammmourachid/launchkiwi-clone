# PocketBase-only secrets, loaded by `npm run pb` (never read by Next.js).
# Copy to pb/.env and fill in.

# Lemon Squeezy. Use a test-mode API key while developing.
# Run `npm run lemonsqueezy:ids` for the store and variant ids.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_PREMIUM=
LEMONSQUEEZY_VARIANT_PRIORITY=
# Sidebar spotlight ads (/advertise). Name the Lemon Squeezy products
# "Spotlight 30" ($30) and "Spotlight 90" ($79) so lemonsqueezy:ids prints these.
LEMONSQUEEZY_VARIANT_SPOTLIGHT_30=
LEMONSQUEEZY_VARIANT_SPOTLIGHT_90=
# The signing secret you type when creating the webhook in Lemon Squeezy.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Where buyers are sent back after paying.
APP_URL=http://localhost:3000
# Public site origin used in launch badges (the badge links to SITE_URL/p/<slug>).
# Defaults to APP_URL.
SITE_URL=https://launchdunes.com
